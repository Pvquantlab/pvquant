# ============================================================
#  PVQuant — SUNUCU .env ŞABLONU  (docker compose kurulumu)
# ============================================================
#  Kullanım:  cp .env.ornek .env   → değerleri doldur → docker compose up -d
#
#  Buradaki liste, docker-compose.yml'in GERÇEKTEN okuduğu değişkenlerin
#  tamamıdır (grep ile çıkarıldı). Fazlası gereksiz, eksiği kuruluma engel.
#
#  YAYINA ÇIKMADAN ÖNCE ŞU KOMUT 0 DÖNMELİ:
#     grep -c "DEGISTIR\|pvquant_dev\|dev-secret" .env
# ============================================================


# --- ZORUNLU: bunlar olmadan compose BAŞLAMAZ -----------------

# Veritabanı parolası. Sunucuda MUTLAKA güçlü ve yeni olmalı.
#   Üret:  openssl rand -base64 24
# NOT: Bu değer veritabanı İLK kurulduğunda kalıcı olarak yazılır.
# Sonradan değiştirmek istersen ALTER USER gerekir, .env yetmez.
DB_PASSWORD=DEGISTIR-openssl-rand-base64-24

# Oturum jetonlarını imzalar. Geliştirme sırrı sunucuya TAŞINMAZ — yenisini üret.
#   Üret:  openssl rand -hex 32
# Boş dize bırakma: kod bunu açık hatayla reddeder (v2.79), sessizce çalışmaz.
PVQ_JWT_SECRET=DEGISTIR-openssl-rand-hex-32


# --- ALAN ADI ve TLS -----------------------------------------

# Gerçek alan adını yazınca Caddy sertifikayı Let's Encrypt'ten OTOMATİK alır.
# Boş/localhost bırakılırsa Caddy kendi yerel CA'sını kullanır (yalnız geliştirme).
# Ön koşul: alan adının A kaydı bu sunucunun IP'sine bakıyor olmalı.
PVQ_DOMAIN=pvquant.com


# --- E-POSTA (opsiyonel ama İŞLEVSEL OLARAK ÖNEMLİ) ----------
#
# Tanımlanmazsa sistem çalışır ama HİÇBİR mektup çıkmaz:
#   · başvuru sahibine teyit gitmez  · parola sıfırlama bağlantısı iletilemez
#   · alarm e-postaları düşmez
# Arayüz bu durumda dürüst davranır ("gönderildi" demez, v2.339) — ama
# müşteriye açılmadan önce doldurulması önerilir.
PVQ_SMTP_HOST=
PVQ_SMTP_PORT=587
PVQ_SMTP_USER=
PVQ_SMTP_PASS=
PVQ_SMTP_FROM=PVQuant <no-reply@pvquant.com>
# STARTTLS kapatmak için 0 (yalnız yerel sınama sunucusu); normalde boş bırak.
PVQ_SMTP_TLS=

# Yeni vitrin başvurusu bildirimi buraya düşer (boşsa yalnız panelde görünür).
PVQ_BILDIRIM_EPOSTA=
# Santral alarmları buraya gider (worker).
PVQ_ALARM_TO=


# --- OPSİYONEL ------------------------------------------------

# Hata izleme (boşsa sessizce kapalı).
PVQ_SENTRY_DSN=

# Gece veritabanı yedeğini kapatmak için herhangi bir değer yaz.
# Boş bırak = yedek AÇIK (önerilen). Yedekler ./yedekler klasörüne düşer,
# son 14 tanesi tutulur. Sunucuda bu klasörü KUTU DIŞINA da kopyala.
PVQ_YEDEK_KAPALI=
