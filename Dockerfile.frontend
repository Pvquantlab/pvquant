# PVQuant frontend imaji (v2.64) — Streamlit UI
# Worker imajinin ikizi + UI cifti (streamlit/plotly) + frontend/assets kopyasi.
# libgomp1: UI'dan tetiklenen kalibrasyon lightgbm kosar (4 sayfa hibrit cagiriyor).
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir . "streamlit>=1.28" "plotly>=5.0"

COPY frontend ./frontend
COPY assets ./assets

EXPOSE 8501
CMD ["streamlit", "run", "frontend/Ana.py", \
     "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
