{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "autoPort": true
    },
    {
      "name": "tasarim-mockup",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8710",
        "--directory",
        "docs/design/redesign-2026"
      ],
      "port": 8710,
      "autoPort": false
    },
    {
      "name": "web-ornek-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && npx vite preview --outDir dist-ornek --port 4373 --strictPort"
      ],
      "port": 4373,
      "autoPort": false
    }
  ]
}