# PVQuant Configuration Example
# Copy this file to .env and fill in real values

# Application
PVQUANT_ENV=development
PVQUANT_LOG_LEVEL=INFO

# API
PVQUANT_API_HOST=0.0.0.0
PVQUANT_API_PORT=8000
PVQUANT_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Open-Meteo (no API key required, but rate-limited)
PVQUANT_METEO_BASE_URL=https://api.open-meteo.com/v1
PVQUANT_METEO_TIMEOUT=30

# Cache
PVQUANT_CACHE_TTL_SECONDS=3600


# ============================================================
# --- GO-LIVE (P4-D) — prod .env için, Zeyilname v2.25 ---
# ============================================================
# GÜN 0 kontrol kanıtı: grep -c "dev-secret-DEGISTIR\|pvquant_dev" .env = 0
# (bu iki string prod .env'de KALIRSA go-live YASAK)

# --- Madde 2: Sırlar (JWT + DB) ---
# JWT secret üretimi: openssl rand -base64 32
# Kanıt: uzunluğu ≥32 bayt olmalı
PVQ_JWT_SECRET=degistir-32-bayt-openssl-rand-base64-32

# DB URL prod (uygulama rolü pvq_app_login — Madde 3 sonrası):
# postgresql+psycopg://pvq_app_login:GUCLU_SIFRE@db-host:5432/pvquant
PVQ_DB_URL=postgresql+psycopg://pvq_app_login:DEGISTIR@localhost:5432/pvquant

# --- Madde 4: Sentry DSN ---
# Env yoksa sessiz; b1 kabul kanıtı: geçici 1/0 endpoint + panel event
PVQ_SENTRY_DSN=

# --- Madde 5: SMTP beşlisi (P4-A alarm servisi) ---
# Env yoksa alarm mail gönderemez, log'a düşer (dev davranışı)
# Kanıt: kendine test alarmı → kutuda [PVQuant] veri_gelmedi maili
PVQ_SMTP_HOST=smtp.gmail.com
PVQ_SMTP_PORT=587
PVQ_SMTP_USER=uyari@sirketiniz.com
PVQ_SMTP_PASS=DEGISTIR
PVQ_SMTP_FROM=PVQuant <uyari@sirketiniz.com>
PVQ_ALARM_TO=operasyon@sirketiniz.com

# --- Alembic (Madde 3: Alembic ayrı admin URL ile koşar) ---
# Migration süperkullanıcı işi, uygulama değil
# ALEMBIC_DB_URL=postgresql+psycopg://pvquant_admin:GUCLU@db-host:5432/pvquant
