# PVQuant Configuration Example
# Copy this file to .env and fill in real values

# Application
PVQUANT_ENV=development
PVQUANT_LOG_LEVEL=INFO

# API
PVQUANT_API_HOST=0.0.0.0
PVQUANT_API_PORT=8000
PVQUANT_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Open-Meteo (no API key required, but rate-limited)
PVQUANT_METEO_BASE_URL=https://api.open-meteo.com/v1
PVQUANT_METEO_TIMEOUT=30

# Cache
PVQUANT_CACHE_TTL_SECONDS=3600
