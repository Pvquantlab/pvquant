# PVQuant TLS kapisi (v2.64)
# PVQ_DOMAIN bos/localhost ise: Caddy kendi yerel CA'siyla https://localhost (Mac durusmasi).
# Sunucuda .env'e PVQ_DOMAIN=app.alanadi.com yazilinca: Let's Encrypt otomatik.
{$PVQ_DOMAIN:localhost} {
	# v2.72: API ayni alan adinin /v1/* yolunda — SPA'da CORS derdi dogmaz.
	# Uc yollari zaten /v1 onekli; soyma (strip) gerekmez.
	route /v1/* {
		reverse_proxy api:8000
	}
	# v2.148: kok artik YENI arayuz (web/ SPA); eski Streamlit dogrudan 8502'de.
	reverse_proxy web:8080
}
